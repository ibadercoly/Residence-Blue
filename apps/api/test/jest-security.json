{
  "preset": "ts-jest/presets/default-esm",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "diagnostics": false,
        "tsconfig": {
          "module": "ESNext"
        }
      }
    ]
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "moduleNameMapper": {
    "^@residence-blue/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
