generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTION
  RECEPTION
  RESTAURANT
  SERVEUR
  CUISINE
  CUISINIER
  HOUSEKEEPING
  MAINTENANCE
  COMPTABLE
}

enum RoomStatus {
  FREE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum InvoiceDocumentType {
  INVOICE
  CREDIT_NOTE
}

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  CARD
  BANK_TRANSFER
}

model User {
  id                         String          @id @default(uuid()) @db.Uuid
  email                      String          @unique
  fullName                   String          @default("") @map("full_name")
  jobTitle                   String?         @map("job_title")
  passwordHash               String          @map("password_hash")
  role                       Role
  isPrimaryAdmin             Boolean         @default(false) @map("is_primary_admin")
  mustChangePassword         Boolean         @default(false) @map("must_change_password")
  starterProfile             String?         @map("starter_profile")
  screenAccess               Json?           @map("screen_access") @db.JsonB
  specialPermissions         Json?           @map("special_permissions") @db.JsonB
  deletedAt                  DateTime?       @map("deleted_at")
  deletedDisplayName         String?         @map("deleted_display_name")
  isActive                   Boolean         @default(true) @map("is_active")
  failedLogins               Int             @default(0) @map("failed_logins")
  lockedUntil                DateTime?       @map("locked_until")
  totpEnabled                Boolean         @default(false) @map("totp_enabled")
  totpSecretEncrypted        String?         @map("totp_secret_encrypted")
  totpPendingSecretEncrypted String?         @map("totp_pending_secret_encrypted")
  totpBackupCodesJson        Json?           @map("totp_backup_codes_json") @db.JsonB
  lastLoginAt                DateTime?       @map("last_login_at")
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]
  syncOps                    SyncOperation[]
  createdReservations        Reservation[]   @relation("CreatedReservations")
  receivedPayments           Payment[]       @relation("ReceivedPayments")
  notificationReads          NotificationRead[]

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  deviceLabel       String?   @map("device_label")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  usedAt            DateTime? @map("used_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model RoomType {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  pricePerNight Int      @map("price_per_night") // ENTIER strict en FCFA
  rooms         Room[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("room_types")
}

model Room {
  id                      String            @id @default(uuid()) @db.Uuid
  number                  String            @unique
  typeId                  String            @map("type_id") @db.Uuid
  type                    RoomType          @relation(fields: [typeId], references: [id], onDelete: Restrict)
  floor                   Int
  category                String            @default("Standard")
  status                  RoomStatus        @default(FREE)
  adultsCapacity          Int               @default(2) @map("adults_capacity")
  childrenCapacity        Int               @default(0) @map("children_capacity")
  bedType                 String            @default("queen") @map("bed_type")
  bedsCount               Int               @default(1) @map("beds_count")
  surfaceM2               Int               @default(25) @map("surface_m2")
  view                    String            @default("jardin")
  smoking                 Boolean           @default(false)
  connectingRoom          String?           @map("connecting_room")
  amenities               String[]
  pricePerNight           Int               @default(35000) @map("price_per_night")
  highSeasonPricePerNight Int?              @map("high_season_price_per_night")
  corporatePricePerNight  Int?              @map("corporate_price_per_night")
  breakfastIncluded       Boolean           @default(true) @map("breakfast_included")
  imageUrl                String?           @map("image_url")
  description             String?           @db.Text
  internalNote            String?           @map("internal_note") @db.Text
  maintenanceReason       String?           @map("maintenance_reason") @db.Text
  isActive                Boolean           @default(true) @map("is_active")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  reservations            Reservation[]
  invoices                Invoice[]
  orders                  RestaurantOrder[]

  @@index([typeId])
  @@index([status])
  @@map("rooms")
}

model Guest {
  id                    String        @id @default(uuid()) @db.Uuid
  civility              String        @default("M.")
  firstName             String        @map("first_name")
  lastName              String        @map("last_name")
  fullName              String        @map("full_name")
  phone                 String
  email                 String?
  nationality           String?       @default("Sénégalaise")
  residenceCity         String?       @map("residence_city")
  companyName           String?       @map("company_name")
  companyRole           String?       @map("company_role")
  vipTier               String?       @map("vip_tier")
  avatarUrl             String?       @map("avatar_url")
  idDocumentEncrypted   String?       @map("id_document_encrypted") @db.Text
  idDocumentType        String?       @map("id_document_type")
  idDocumentExpiry      String?       @map("id_document_expiry")
  birthDate             String?       @map("birth_date")
  address               String?
  internalNote          String?       @map("internal_note") @db.Text
  version               Int           @default(1)
  dietaryPreferences    Json?         @map("dietary_preferences") @db.JsonB
  preferences           Json?         @db.JsonB
  permanentInstructions Json?         @map("permanent_instructions") @db.JsonB
  notes                 Json?         @db.JsonB
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  reservations          Reservation[]
  invoices              Invoice[]

  @@index([phone])
  @@index([email])
  @@index([fullName])
  @@index([createdAt])
  @@map("guests")
}

model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  reference     String            @unique
  guestId       String            @map("guest_id") @db.Uuid
  guest         Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomId        String            @map("room_id") @db.Uuid
  room          Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkInDate   DateTime          @map("check_in_date") @db.Date
  checkOutDate  DateTime          @map("check_out_date") @db.Date
  adultsCount   Int               @default(1) @map("adults_count")
  childrenCount Int               @default(0) @map("children_count")
  nights             Int               @default(1)
  status             ReservationStatus @default(CONFIRMED)
  source             String            @default("RECEPTION")
  breakfastIncluded  Boolean           @default(true) @map("breakfast_included")
  discountFcfa       Int               @default(0) @map("discount_fcfa")
  tourismTaxFcfa     Int               @default(0) @map("tourism_tax_fcfa")
  depositFcfa        Int               @default(0) @map("deposit_fcfa")
  totalFcfa     Int               @map("total_fcfa")
  checkedInAt   DateTime?         @map("checked_in_at")
  checkedOutAt  DateTime?         @map("checked_out_at")
  notes         String?           @db.Text
  createdById   String?           @map("created_by_id") @db.Uuid
  createdByName String?           @map("created_by_name")
  createdBy     User?             @relation("CreatedReservations", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  invoices      Invoice[]
  orders        RestaurantOrder[]

  @@index([roomId, checkInDate, checkOutDate])
  @@index([guestId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
  @@index([checkedInAt])
  @@index([checkedOutAt])
  @@index([source])
  @@map("reservations")
}

model Invoice {
  id                   String              @id @default(uuid()) @db.Uuid
  invoiceNumber        String?             @unique @map("invoice_number")
  documentType         InvoiceDocumentType @default(INVOICE) @map("document_type")
  isIssued             Boolean             @default(false) @map("is_issued")
  parentInvoiceId      String?             @map("parent_invoice_id") @db.Uuid
  parentInvoice        Invoice?            @relation("InvoiceCreditNotes", fields: [parentInvoiceId], references: [id], onDelete: Restrict)
  creditNotes          Invoice[]           @relation("InvoiceCreditNotes")
  reason               String?             @db.Text
  reservationId        String?             @map("reservation_id") @db.Uuid
  reservation          Reservation?        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guestId              String?             @map("guest_id") @db.Uuid
  guest                Guest?              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomId               String?             @map("room_id") @db.Uuid
  room                 Room?               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  subtotalHtFcfa       Int                 @default(0) @map("subtotal_ht_fcfa")
  discountFcfa         Int                 @default(0) @map("discount_fcfa")
  serviceRatePercent   Int                 @default(0) @map("service_rate_percent")
  serviceAmountFcfa    Int                 @default(0) @map("service_amount_fcfa")
  vatRatePercent       Int                 @default(10) @map("vat_rate_percent")
  vatAmountFcfa        Int                 @default(0) @map("vat_amount_fcfa")
  tourismTaxFcfa       Int                 @default(0) @map("tourism_tax_fcfa")
  totalFcfa            Int                 @default(0) @map("total_fcfa")
  depositFcfa          Int                 @default(0) @map("deposit_fcfa")
  paidAmountFcfa       Int                 @default(0) @map("paid_amount_fcfa")
  balanceFcfa          Int                 @default(0) @map("balance_fcfa")
  status               InvoiceStatus       @default(OPEN)
  forcedCheckout       Boolean             @default(false) @map("forced_checkout")
  forcedCheckoutReason String?             @map("forced_checkout_reason") @db.Text
  billingCompanyName   String?             @map("billing_company_name")
  billingNinea         String?             @map("billing_ninea")
  billingAddress       String?             @map("billing_address")
  issuedAt             DateTime            @default(now()) @map("issued_at")
  settledAt            DateTime?           @map("settled_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  lines                InvoiceLine[]
  payments             Payment[]

  @@index([reservationId])
  @@index([guestId])
  @@index([roomId])
  @@index([status])
  @@index([parentInvoiceId])
  @@index([isIssued])
  @@index([isIssued, documentType, status, updatedAt])
  @@index([documentType, status, issuedAt])
  @@index([issuedAt])
  @@index([createdAt])
  @@index([balanceFcfa])
  @@map("invoices")
}

model InvoiceSequence {
  id      String @id
  docType String @map("doc_type")
  year    Int
  lastSeq Int    @default(0) @map("last_seq")

  @@map("invoice_sequences")
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dateLabel      String   @default("") @map("date_label")
  description    String
  subDescription String?  @map("sub_description")
  category       String   @default("HEBERGEMENT")
  quantity       Int      @default(1)
  quantityLabel  String?  @map("quantity_label")
  unitPriceFcfa  Int      @map("unit_price_fcfa")
  totalPriceFcfa Int      @map("total_price_fcfa")
  isSystem       Boolean  @default(false) @map("is_system")
  sourceOrderId  String?  @map("source_order_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([sourceOrderId])
  @@index([category])
  @@map("invoice_lines")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  method            PaymentMethod
  amountFcfa        Int           @map("amount_fcfa")
  transactionRef    String?       @map("transaction_ref")
  receivedById      String?       @map("received_by_id") @db.Uuid
  receivedBy        User?         @relation("ReceivedPayments", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedByName    String?       @map("received_by_name")
  isReversal        Boolean       @default(false) @map("is_reversal")
  reversedPaymentId String?       @map("reversed_payment_id") @db.Uuid
  reversalReason    String?       @map("reversal_reason") @db.Text
  idempotencyKey    String?       @unique @map("idempotency_key")
  paidAt            DateTime      @default(now()) @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([method])
  @@index([paidAt])
  @@index([reversedPaymentId])
  @@map("payments")
}

model RestaurantCategory {
  id           String              @id @default(uuid()) @db.Uuid
  name         String              @unique
  icon         String              @default("dinner_dining")
  displayOrder Int                 @default(1) @map("display_order")
  isArchived   Boolean             @default(false) @map("is_archived")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  products     RestaurantProduct[]

  @@map("restaurant_categories")
}

model RestaurantProduct {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @unique
  description          String                @default("") @db.Text
  categoryId           String                @map("category_id") @db.Uuid
  category             RestaurantCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceFcfa            Int                   @map("price_fcfa")
  halfPortionPriceFcfa Int?                  @map("half_portion_price_fcfa")
  tags                 String[]
  allergens            String[]
  prepTimeMinutes      Int                   @default(15) @map("prep_time_minutes")
  prepStation          String                @default("CUISINE") @map("prep_station")
  availability         Json?                 @db.JsonB
  options              Json?                 @db.JsonB
  vatRatePercent       Int                   @default(10) @map("vat_rate_percent")
  displayOrder         Int                   @default(1) @map("display_order")
  photoUrl             String?               @map("photo_url")
  thumbnailUrl         String?               @map("thumbnail_url")
  status               String                @default("AVAILABLE")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  orderLines           RestaurantOrderLine[]

  @@index([categoryId])
  @@index([status])
  @@index([status, displayOrder])
  @@map("restaurant_products")
}

model RestaurantOrder {
  id              String                @id @default(uuid()) @db.Uuid
  ticketNumber    String                @unique @map("ticket_number")
  idempotencyKey  String?               @unique @map("idempotency_key")
  destinationType String                @default("TABLE") @map("destination_type")
  tableLabel      String?               @map("table_label")
  roomId          String?               @map("room_id") @db.Uuid
  room            Room?                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservationId   String?               @map("reservation_id") @db.Uuid
  reservation     Reservation?          @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  invoiceId          String?               @map("invoice_id") @db.Uuid
  guestName          String?               @map("guest_name")
  serverName      String                @default("Service") @map("server_name")
  status          String                @default("PENDING")
  subtotalHtFcfa  Int                   @default(0) @map("subtotal_ht_fcfa")
  vatAmountFcfa   Int                   @default(0) @map("vat_amount_fcfa")
  totalTtcFcfa    Int                   @default(0) @map("total_ttc_fcfa")
  paymentMethod      String?               @map("payment_method")
  cancellationReason String?               @map("cancellation_reason") @db.Text
  cancelledAt        DateTime?             @map("cancelled_at")
  cancelledById      String?               @map("cancelled_by_id") @db.Uuid
  cancelledByName    String?               @map("cancelled_by_name")
  preparingAt        DateTime?             @map("preparing_at")
  readyAt            DateTime?             @map("ready_at")
  servedAt           DateTime?             @map("served_at")
  statut                  String                @default("ENVOYEE") @map("statut")
  envoyeeAt               DateTime              @default(now()) @map("envoyee_at")
  envoyeeById             String?               @map("envoyee_by_id") @db.Uuid
  priseEnChargeAt         DateTime?             @map("prise_en_charge_at")
  priseEnChargeById       String?               @map("prise_en_charge_by_id") @db.Uuid
  priseEnChargeByName     String?               @map("prise_en_charge_by_name")
  tempsPreparationMinutes Int?                  @map("temps_preparation_minutes")
  heureFinPrevue          DateTime?             @map("heure_fin_prevue")
  preteAt                 DateTime?             @map("prete_at")
  preteById               String?               @map("prete_by_id") @db.Uuid
  serviAt                 DateTime?             @map("servi_at")
  serviById               String?               @map("servi_by_id") @db.Uuid
  annuleAt                DateTime?             @map("annule_at")
  annuleById              String?               @map("annule_by_id") @db.Uuid
  motifAnnulation         String?               @map("motif_annulation") @db.Text
  autoriseAt              DateTime?             @map("autorise_at")
  autoriseById            String?               @map("autorise_by_id") @db.Uuid
  autoriseByName          String?               @map("autorise_by_name")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  lines           RestaurantOrderLine[]
  events          RestaurantOrderEvent[]

  @@index([roomId])
  @@index([reservationId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([destinationType, createdAt])
  @@map("orders")
}

model RestaurantOrderLine {
  id              String             @id @default(uuid()) @db.Uuid
  orderId         String             @map("order_id") @db.Uuid
  order           RestaurantOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?            @map("product_id") @db.Uuid
  product         RestaurantProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name            String
  quantity        Int                @default(1)
  unitPriceFcfa   Int                @map("unit_price_fcfa")
  totalPriceFcfa  Int                @map("total_price_fcfa")
  selectedOptions String[]           @map("selected_options")
  notes           String?
  prepStation     String             @default("CUISINE") @map("prep_station")
  isUnavailable   Boolean            @default(false) @map("is_unavailable")
  unavailableReason String?          @map("unavailable_reason") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_lines")
}

model RestaurantOrderEvent {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  order            RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type             String
  detail           String          @db.Text
  userId           String?         @map("user_id") @db.Uuid
  userName         String?         @map("user_name")
  addedMinutes     Int?            @map("added_minutes")
  unavailableItems String[]        @default([]) @map("unavailable_items")
  reason           String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_events")
}

model HotelSetting {
  id                          String   @id @default("default")
  hotelName                   String   @default("Résidence Blue") @map("hotel_name")
  legalName                   String   @default("Résidence Blue S.A.R.L.") @map("legal_name")
  tagline                     String   @default("Hôtel Boutique • Grand Standing, Thiès")
  city                        String   @default("Thiès")
  neighborhood                String   @default("Grand Standing")
  country                     String   @default("Sénégal")
  fullAddress                 String   @default("Quartier Grand Standing • Thiès, Sénégal") @map("full_address")
  ninea                       String   @default("004819230")
  rccm                        String   @default("SN-THS-2021-B-114")
  supportPhone                String   @default("+221 33 957 00 00") @map("support_phone")
  supportEmail                String   @default("support@residenceblue.sn") @map("support_email")
  roomCount                   Int      @default(12) @map("room_count")
  restaurantName              String   @default("La Teranga") @map("restaurant_name")
  currency                    String   @default("XOF")
  vatRatePercent              Int      @default(10) @map("vat_rate_percent")
  serviceRatePercent          Int?     @map("service_rate_percent")
  tourismTaxPerNightPerPerson Int      @default(1000) @map("tourism_tax_per_night_per_person")
  discountThresholdPercent    Int?     @map("discount_threshold_percent")
  invoiceLogoPath             String?  @map("invoice_logo_path")
  exchangeRateEurToFcfa       Float    @default(655.957) @map("exchange_rate_eur_to_fcfa")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("hotel_settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  seq       Int      @unique @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?
  prevHash  String?  @map("prev_hash")
  entryHash String?  @map("entry_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model SyncOperation {
  idempotencyKey String   @id @unique @map("idempotency_key")
  userId         String?  @map("user_id") @db.Uuid
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  result         Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sync_operations")
}

model NotificationMessage {
  id               String             @id @default(uuid()) @db.Uuid
  category         String             @default("RESTAURANT")
  type             String
  severity         String             @default("INFO")
  orderId          String?            @map("order_id") @db.Uuid
  destinationType  String?            @map("destination_type")
  roomNumber       String?            @map("room_number")
  destinationLabel String             @map("destination_label")
  guestName        String?            @map("guest_name")
  title            String             @db.Text
  link             String
  importantAlert   Boolean            @default(false) @map("important_alert")
  createdAt        DateTime           @default(now()) @map("created_at")
  reads            NotificationRead[]

  @@index([createdAt])
  @@index([orderId, type])
  @@index([category, createdAt])
  @@map("notification_messages")
}

model NotificationRead {
  notificationId String              @map("notification_id") @db.Uuid
  notification   NotificationMessage @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String              @map("user_id") @db.Uuid
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime            @default(now()) @map("read_at")

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_reads")
}
