# Résidence Blue - Variables d'environnement

# Environnement
NODE_ENV=development
PORT=3000

# Base de données PostgreSQL 16
DATABASE_URL=postgresql://blue_user:blue_password@localhost:5432/residence_blue_db?schema=public
POSTGRES_USER=blue_user
POSTGRES_PASSWORD=blue_password
POSTGRES_DB=residence_blue_db

# Clé de chiffrement maître AES-256-GCM (32 octets sous forme hexadécimale, ex: 64 caractères hex)
# Ne jamais commiter de vraie clé dans Git !
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret pour l'authentification
JWT_SECRET=super_secret_jwt_residence_blue_dev_key_only_change_in_prod
JWT_EXPIRATION=8h
